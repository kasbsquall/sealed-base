# Base
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
# 84532 for Base Sepolia, 8453 for Base mainnet.
SEALED_CHAIN_ID=84532
# Use a fresh wallet funded from a Base Sepolia faucet, never a personal one.
DEPLOYER_PRIVATE_KEY=
# Optional, for contract verification on Basescan.
BASESCAN_API_KEY=

# x402 payment after settlement. The public facilitator supports Base Sepolia
# and pays the gas; leave empty to use it.
X402_FACILITATOR_URL=

# Negotiator agent LLM (any OpenAI-compatible endpoint). Default: Ollama on this
# machine, so an agent's mandate never leaves it. For a hosted model instead:
# LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-6-luna  LLM_API_KEY=...
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b-instruct
LLM_API_KEY=
