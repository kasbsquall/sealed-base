# Base
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
# 84532 for Base Sepolia, 8453 for Base mainnet.
SEALED_CHAIN_ID=84532
# Use a fresh wallet funded from a Base Sepolia faucet, never a personal one.
DEPLOYER_PRIVATE_KEY=
# Optional, for contract verification on Basescan.
BASESCAN_API_KEY=

# Privy agent wallets
# App id and secret from the Privy dashboard.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Key quorum that owns the mandate policy and the agent wallets.
PRIVY_KEY_QUORUM_ID=
# Base64 PKCS8 authorization private key, no PEM headers. This backend signs
# API requests with it. It is NOT the wallet key: that never leaves Privy.
PRIVY_AUTHORIZATION_KEY=
PRIVY_POLICY_ID=

# Negotiator agent LLM (any OpenAI-compatible endpoint). Default: Ollama on this
# machine, so an agent's mandate never leaves it. For a hosted model instead:
# LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-6-luna  LLM_API_KEY=...
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b-instruct
LLM_API_KEY=
